<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ page import="java.util.List,model.Student" %>
<%! private String esc(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>
<% @SuppressWarnings("unchecked") List<Student> students = (List<Student>)request.getAttribute("studentList"); if(students==null) students=java.util.Collections.emptyList(); int cs=0,it=0,other=0; for(Student s:students){String c=s.getCourse()==null?"":s.getCourse().toLowerCase(); if(c.contains("computer")||c.contains("software"))cs++;else if(c.contains("information")||c.contains("it"))it++;else other++;} %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Overview · studentPartner</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="<%=request.getContextPath()%>/ListStudentServlet"><span class="brand-mark">N</span> studentPartner<span class="brand-light">/edu</span></a><div class="side-label">WORKSPACE</div><a class="side-link active" href="<%=request.getContextPath()%>/ListStudentServlet"><span>◫</span> Overview</a><a class="side-link" href="#records"><span>▤</span> Students <span class="side-count"><%=students.size()%></span></a><div class="side-label side-label-lower">MANAGE</div><a class="side-link" href="<%=request.getContextPath()%>/addStudent.jsp"><span>＋</span> Add student</a><div class="sidebar-bottom"><div class="admin-profile"><span class="avatar avatar-admin">A</span><span><strong>Admin</strong><small>Administrator</small></span></div><form action="<%=request.getContextPath()%>/admin/logout" method="post"><button class="logout-button">↗ <span>Sign out</span></button></form></div></aside>
<main class="main-area"><header class="topbar"><div class="breadcrumb">Workspace <span>/</span> Overview</div><div class="topbar-right"><span class="live-label"><i></i> SYSTEM LIVE</span><span class="avatar avatar-admin">A</span></div></header><div class="dashboard-wrap"><div class="welcome-row"><div><span class="eyebrow">MONDAY, <%=java.time.LocalDate.now().format(java.time.format.DateTimeFormatter.ofPattern("MMMM d, yyyy", java.util.Locale.ENGLISH)).toUpperCase()%></span><h1>Good morning, Admin <span class="wave">✳</span></h1><p class="muted">Here’s what’s happening across your student community.</p></div><a class="btn btn-primary" href="<%=request.getContextPath()%>/addStudent.jsp"><b>＋</b> Add student</a></div>
<section class="metric-grid"><article class="metric-card"><div class="metric-top"><span>Total students</span><span class="metric-icon blue">▤</span></div><div class="metric-number"><%=students.size()%></div><div class="metric-note"><span class="metric-trend">↗</span> Enrolled student records</div><div class="metric-line blue-line"></div></article><article class="metric-card"><div class="metric-top"><span>Computer & software</span><span class="metric-icon violet">⌘</span></div><div class="metric-number"><%=cs%></div><div class="metric-note">Students in this group</div><div class="metric-line violet-line"></div></article><article class="metric-card"><div class="metric-top"><span>Information technology</span><span class="metric-icon green">⌁</span></div><div class="metric-number"><%=it%></div><div class="metric-note">Students in this group</div><div class="metric-line green-line"></div></article><article class="metric-card"><div class="metric-top"><span>Other programs</span><span class="metric-icon amber">✳</span></div><div class="metric-number"><%=other%></div><div class="metric-note">Across all other courses</div><div class="metric-line amber-line"></div></article></section>
<section class="records-card" id="records"><div class="records-heading"><div><span class="eyebrow">DIRECTORY</span><h2>Student records <span class="count-pill"><%=students.size()%></span></h2><p>Manage your student information in one place.</p></div><a class="btn btn-primary btn-small" href="<%=request.getContextPath()%>/addStudent.jsp">＋ New student</a></div><div class="table-controls"><label class="search-box"><span>⌕</span><input id="searchInput" type="search" placeholder="Search name, email or course…" oninput="filterRows()"><kbd>⌘ K</kbd></label><label class="select-wrap"><span>↕</span><select id="sortSelect" onchange="sortRows()"><option value="default">Sort: Recently added</option><option value="name">Name: A to Z</option><option value="course">Course: A to Z</option><option value="email">Email: A to Z</option></select></label></div>
<% if(students.isEmpty()){ %><div class="empty-state"><span class="empty-icon">▤</span><h3>Your directory is ready</h3><p>Add your first student to start building the community.</p><a class="btn btn-primary" href="<%=request.getContextPath()%>/addStudent.jsp">＋ Add first student</a></div><% }else{ %><div class="table-wrap"><table class="records-table" id="studentTable"><thead><tr><th>STUDENT</th><th>EMAIL ADDRESS</th><th>COURSE</th><th>STUDENT ID</th><th></th></tr></thead><tbody><%for(Student s:students){String initials=""; if(s.getName()!=null)for(String part:s.getName().trim().split("\\s+")){if(!part.isEmpty())initials+=part.substring(0,1).toUpperCase();if(initials.length()==2)break;}%><tr><td><div class="person-cell"><span class="avatar avatar-person"><%=initials%></span><span class="person-name"><strong><%=esc(s.getName())%></strong><small>Student</small></span></div></td><td class="email-cell"><%=esc(s.getEmail())%></td><td><span class="course-tag"><i></i><%=esc(s.getCourse())%></span></td><td class="id-cell">#STU-<%=String.format("%04d",s.getId())%></td><td><div class="row-actions"><a class="icon-action" title="Edit student" aria-label="Edit student" href="<%=request.getContextPath()%>/UpdateStudentServlet?id=<%=s.getId()%>">↗</a><form action="<%=request.getContextPath()%>/DeleteStudentServlet" method="post" onsubmit="return confirm('Delete <%=esc(s.getName()).replace("'","\\'")%>’s student record? This cannot be undone.');"><input type="hidden" name="id" value="<%=s.getId()%>"><button class="icon-action delete-action" type="submit" title="Delete student" aria-label="Delete student">×</button></form></div></td></tr><%}%></tbody></table></div><div class="table-footer"><span>Showing <strong id="visibleCount"><%=students.size()%></strong> of <strong><%=students.size()%></strong> students</span><span>Records are saved to your database <i class="footer-dot"></i></span></div><% } %></section><footer class="main-footer"><span>studentPartner · Student operations</span><span>All changes are saved automatically</span></footer></div></main>
<script>function filterRows(){var q=document.getElementById('searchInput').value.toLowerCase(),rows=document.querySelectorAll('#studentTable tbody tr'),n=0;rows.forEach(function(r){var show=r.textContent.toLowerCase().includes(q);r.style.display=show?'':'none';if(show)n++});var c=document.getElementById('visibleCount');if(c)c.textContent=n}function sortRows(){var body=document.querySelector('#studentTable tbody');if(!body)return;var key=document.getElementById('sortSelect').value,rows=Array.from(body.rows);if(key==='default')rows.sort(function(a,b){return parseInt(b.cells[3].textContent.replace(/\\D/g,''),10)-parseInt(a.cells[3].textContent.replace(/\\D/g,''),10)});else rows.sort(function(a,b){var i=key==='name'?0:key==='email'?1:2;return a.cells[i].textContent.trim().localeCompare(b.cells[i].textContent.trim())});rows.forEach(function(r){body.appendChild(r)});filterRows()}document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();document.getElementById('searchInput').focus()}});</script></body></html>
