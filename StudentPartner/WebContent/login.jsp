<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<% if (session.getAttribute("admin") != null) { response.sendRedirect(request.getContextPath() + "/ListStudentServlet"); return; } %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in · studentPartner Admin</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head>
<body class="login-page"><main class="login-shell"><section class="login-story"><a class="brand" href="<%=request.getContextPath()%>/login.jsp"><span class="brand-mark">N</span> studentPartner<span class="brand-light">/edu</span></a><div class="story-copy"><span class="eyebrow">STUDENT OPERATIONS</span><h1>Make room for<br>what matters.</h1><p>A calmer, clearer way to keep your student records moving forward.</p></div><div class="story-foot"><span class="status-dot"></span> Your campus, in good hands <span>•</span> EST. 2025</div></section><section class="login-panel"><div class="login-card"><span class="eyebrow">ADMIN PORTAL</span><h2>Welcome back</h2><p class="muted">Sign in to continue to your workspace.</p><% if("1".equals(request.getParameter("error"))){ %><div class="alert alert-danger">Those details didn’t match. Please try again.</div><% } if("1".equals(request.getParameter("loggedOut"))){ %><div class="alert alert-success">You’re signed out. See you next time.</div><% } %><form action="<%=request.getContextPath()%>/admin/login" method="post"><label for="username">Username</label><input class="form-control" id="username" name="username" autocomplete="username" placeholder="Your username" required autofocus><label for="password">Password</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" required><button class="btn btn-primary login-submit" type="submit">Sign in <span>→</span></button></form><p class="login-help">Need access? Contact your system administrator.</p></div><footer class="login-legal">© <%=java.time.Year.now().getValue()%> studentPartner <span>Secure admin access</span></footer></section></main></body></html>
